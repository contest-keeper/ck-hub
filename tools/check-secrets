#!/usr/bin/env bash
# Scans what git would commit (staged changes, modified and new files that are not ignored) for secrets.
# Run it before committing: tools/check-secrets. Add "ck-allow-secret" on a line to allow a fake value.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

patterns=(
  '-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----'
  'AKIA[0-9A-Z]{16}'
  'gh[pousr]_[A-Za-z0-9]{36,}'
  'github_pat_[A-Za-z0-9_]{40,}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'
  'AccountKey=[A-Za-z0-9+/=]{20,}'
  '(postgres|postgresql|mysql)://[^:@/ ]+:[^@ ]{6,}@'
)
bad_names='(^|/)(\.env(\..*)?|.*\.pem|.*\.pfx|.*\.p12|id_(rsa|ed25519))$'

files=$(
  {
    git diff --cached --name-only --diff-filter=ACMR
    git diff --name-only --diff-filter=ACMR
    git ls-files --others --exclude-standard
  } | sort -u
)

found=0
while IFS= read -r file; do
  [ -n "$file" ] && [ -f "$file" ] || continue
  if [[ "$file" =~ $bad_names ]] && [[ "$file" != *.example ]]; then
    echo "check-secrets: $file looks like a secret file; keep it out of git"
    found=1
    continue
  fi
  for pattern in "${patterns[@]}"; do
    hits=$(grep -nIE -e "$pattern" -- "$file" | grep -v 'ck-allow-secret' | grep -v 'ck-test-only' || true)
    if [ -n "$hits" ]; then
      # Print the place, never the matched text.
      while IFS= read -r hit; do
        echo "check-secrets: $file:${hit%%:*} matches /$pattern/"
      done <<<"$hits"
      found=1
    fi
  done
done <<<"$files"

if [ "$found" -ne 0 ]; then
  echo "check-secrets: found possible secrets (values not shown)"
  exit 1
fi
echo "check-secrets: nothing found"
